# Local development reads these from .env.local. The deployed site is built by
# .github/workflows/deploy.yml, which takes credentials from repository secrets
# and the OPEN_METEO_*, TMDB_REGION and COMICVINE_PUBLISHERS settings from
# repository variables.

# Login. Leave both blank locally to run without encryption; the GitHub build
# refuses to publish without them. See docs/login-setup.md.
BRIEFING_DATA_KEY=
BRIEFING_PASSWORD=

# AI daily summary ("Your day at a glance"). Without a key the card is simply
# absent. The build sends Claude the day's calendar, weather, reminders,
# occasions and sports results; see lib/server/daily-brief.ts. BRIEF_MODEL
# defaults to claude-opus-5-5; claude-haiku-5-5 costs far less.
ANTHROPIC_API_KEY=
BRIEF_MODEL=

# "You might have forgotten": comma-separated event-title fragments to leave
# out of the checks, e.g. placeholder holds.
HEADS_UP_IGNORE_TITLES=

# Leave-by times. A free OpenRouteService key (openrouteservice.org) and your
# home address, both kept as secrets. Times are typical driving times without
# live traffic, plus TRAVEL_BUFFER_MINUTES to get out of the door.
ORS_API_KEY=
HOME_ADDRESS=
TRAVEL_BUFFER_MINUTES=10

# Private work-calendar subscription
WORK_CALENDAR_ICAL_URL=
WORK_CALENDAR_ICAL_LABEL=Work calendar
WORK_CALENDAR_ICAL_TIMEOUT_MS=8000
WORK_CALENDAR_ICAL_CACHE_SECONDS=300

# Private Apple/iCloud home-calendar subscription
HOME_CALENDAR_ICAL_URL=
HOME_CALENDAR_ICAL_LABEL=Home calendar
HOME_CALENDAR_ICAL_TIMEOUT_MS=8000
HOME_CALENDAR_ICAL_CACHE_SECONDS=300

# Apple Reminders. The deployed build decrypts the snapshot the Shortcut sent
# with this key (at least 32 characters); see docs/apple-setup.md. Locally,
# the card stays hidden unless a snapshot file exists at the path below.
REMINDERS_KEY=
# REMINDERS_SNAPSHOT_PATH=.data/reminders.enc

# Photo of the day, from an iCloud Shared Album with Public Website turned on.
# The card is hidden without it.
ICLOUD_SHARED_ALBUM_URL=
ICLOUD_SHARED_ALBUM_TIMEOUT_MS=10000

# Open-Meteo (optional; these are the built-in Chicago defaults)
# Note: the briefing overrides FORECAST_DAYS and PAST_DAYS with the range the
# day pager needs, so those two only apply to other callers of the provider.
OPEN_METEO_LATITUDE=41.8781
OPEN_METEO_LONGITUDE=-87.6298
OPEN_METEO_LOCATION=Chicago, IL
OPEN_METEO_TIMEZONE=America/Chicago
OPEN_METEO_TEMPERATURE_UNIT=fahrenheit
OPEN_METEO_FORECAST_DAYS=3
OPEN_METEO_PAST_DAYS=0
OPEN_METEO_TIMEOUT_MS=5000
OPEN_METEO_CACHE_SECONDS=900

# Quote of the day (api-ninjas.com). Without a key the quote is simply omitted.
# Free keys are personal-use only; API Ninjas requires a paid plan for commercial use.
API_NINJAS_KEY=
QUOTE_TIMEOUT_MS=6000
QUOTE_CACHE_SECONDS=3600

# BoardGameGeek hot list. The card is hidden entirely without a token.
# A BGG login is NOT enough: register a free non-commercial application at
# https://boardgamegeek.com/applications, wait for approval (a week or more),
# then create a token under it. Displaying the data requires "Powered by BGG"
# attribution, which the card renders.
BGG_API_TOKEN=
BGG_TIMEOUT_MS=8000
BGG_CACHE_SECONDS=3600

# Upcoming releases card.
#
# The card needs no credential at all: Reactor's SFF book roundups are public,
# so books always appear. Films, television, and comics each switch on when
# their credential is present, and the card simply omits a medium without one.
#
# Films and television come from TMDB, not IMDb — IMDb publishes no free
# release-calendar API. Register free at https://www.themoviedb.org/settings/api
# and set EITHER the v4 read access token (preferred) or the v3 key.
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=
# Which country's theatrical dates to use.
TMDB_REGION=US
TMDB_TIMEOUT_MS=8000
#
# Comics come from Comic Vine. Register a free key at
# https://comicvine.gamespot.com/api/ (needs a GameSpot account); the key is
# shown on that page once you are logged in, and is 40 hex characters — the
# site login itself is not an API credential.
#
# Note that comics are the one medium reported as already out rather than due.
# Comic Vine only records an issue once it has shipped: a forward thirty-day
# window holds four issues, the preceding thirty hold 737. Metron does publish
# forward-dated store dates and would be the better source, but it is
# unreachable from some networks.
#
# The budget is 200 requests per resource per hour; the provider reads newest
# first, stops as soon as it has enough rows, and caches each volume's
# publisher for the life of the process to stay well inside it.
COMICVINE_API_KEY=
# Publishers to follow, comma separated, matched as a substring of the
# publisher's name. Defaults to "Marvel,DC Comics".
COMICVINE_PUBLISHERS=
# Comic Vine answers 403 to a generic client, so requests are sent with a
# distinct User-Agent. Override it here if they ever block the default.
COMICVINE_USER_AGENT=
# Only needed if issue covers stop being served from a gamespot.com or
# cbsistatic.com host; add the cover host here and in next.config.ts to let
# next/image load it.
COMICVINE_IMAGE_HOSTS=
COMICVINE_TIMEOUT_MS=8000
#
# Reactor SFF book roundups. No credential; timeout only.
REACTOR_TIMEOUT_MS=8000
#
# How far ahead the card looks, and how long the merged list is cached.
RELEASES_HORIZON_DAYS=30
RELEASES_CACHE_SECONDS=21600

# Live sports and headline feeds (optional overrides)
# A premium key unlocks the v2 API (richer schedules, league standings).
# When blank, the documented free key is used against v1, which v2 rejects.
THESPORTSDB_API_KEY=
SPORTS_TIMEOUT_MS=8000
SPORTS_CACHE_SECONDS=900
NEWS_TIMEOUT_MS=8000
NEWS_CACHE_SECONDS=900
